{
  "name": "gotovalues-site",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint src tests next.config.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "rm -rf .next .open-next; mv pnpm-lock.yaml pnpm-lock.yaml.deploybak 2>/dev/null; mv pnpm-workspace.yaml pnpm-workspace.yaml.deploybak 2>/dev/null; opennextjs-cloudflare build && opennextjs-cloudflare deploy; status=$?; [ -f pnpm-lock.yaml.deploybak ] && mv pnpm-lock.yaml.deploybak pnpm-lock.yaml; [ -f pnpm-workspace.yaml.deploybak ] && mv pnpm-workspace.yaml.deploybak pnpm-workspace.yaml; exit $status",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hermes/design-tokens": "workspace:*",
    "@hermes/ui": "workspace:*",
    "@opennextjs/cloudflare": "1.19.10",
    "@sentry/nextjs": "^10.53.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "posthog-js": "^1.374.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/nextjs-vite": "^10.4.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.17",
    "@types/react": "^19.2.2",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-storybook": "^10.4.0",
    "global-jsdom": "^29.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "dompurify": ">=3.4.0",
    "fast-xml-parser": ">=5.5.6",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=4.0.4",
    "undici": ">=7.24.0",
    "brace-expansion": ">=2.0.3",
    "yaml": ">=2.8.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10"
    }
  }
}
