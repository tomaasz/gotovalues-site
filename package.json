{
  "name": "gotovalues-site",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint src tests next.config.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/aws": "3.9.16",
    "@opennextjs/cloudflare": "1.19.6",
    "@sentry/nextjs": "^10.52.0",
    "clsx": "^2.1.1",
    "next": "16.2.4",
    "posthog-js": "^1.372.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.17",
    "@types/react": "^19.2.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.2.6",
    "global-jsdom": "^29.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.90.0"
  },
  "overrides": {
    "dompurify": ">=3.4.0",
    "fast-xml-parser": ">=5.5.6",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=4.0.4",
    "undici": ">=7.24.0",
    "brace-expansion": ">=2.0.3",
    "yaml": ">=2.8.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10"
    }
  }
}
