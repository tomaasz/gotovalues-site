# API key for Resend to send emails
RESEND_API_KEY=

# Target email address to receive contact form submissions
CONTACT_TO_EMAIL=

# Sender email address used to send contact form submissions (optional)
CONTACT_FROM_EMAIL=

# PostHog API key for analytics
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog host URL for analytics
NEXT_PUBLIC_POSTHOG_HOST=

# Microsoft Clarity project ID for heatmaps + session recordings (optional)
NEXT_PUBLIC_CLARITY_ID=

# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX" (optional, consent-gated)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry DSN for error tracking and performance monitoring
SENTRY_DSN=

# Sentry environment (defaults to 'production')
SENTRY_ENVIRONMENT=production

# Sentry release version for tracking regressions across deployments
SENTRY_RELEASE=

# Sentry traces sample rate for performance monitoring (defaults to '0.1' i.e. 10%)
SENTRY_TRACES_SAMPLE_RATE=0.1
